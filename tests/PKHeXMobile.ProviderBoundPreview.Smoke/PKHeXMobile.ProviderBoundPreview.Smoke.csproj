<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <Target Name="RequirePinnedPKForge" BeforeTargets="ResolveReferences" Condition="'$(PKForgeRoot)' == ''">
    <Error Text="Set PKForgeRoot to the official-Core-adapted pinned PKForge checkout." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="../../src/PKHeXMobile.PortConsolidation/PKHeXMobile.PortConsolidation.csproj" />
  </ItemGroup>
</Project>
