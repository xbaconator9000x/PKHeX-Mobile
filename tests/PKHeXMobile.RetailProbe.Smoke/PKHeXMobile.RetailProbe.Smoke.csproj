<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <Target Name="RequirePinnedPKForge" BeforeTargets="ResolveReferences" Condition="'$(PKForgeRoot)' == ''">
    <Error Text="Set PKForgeRoot to the exact, pre-adapted temporary upstream checkout." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="$(PKForgeRoot)/src/PKForge.Engine/PKForge.Engine.csproj" />
  </ItemGroup>
</Project>
