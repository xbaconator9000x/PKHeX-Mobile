<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <Target Name="RequirePinnedPKForge" BeforeTargets="ResolveReferences" Condition="'$(PKForgeRoot)' == ''">
    <Error Text="Set PKForgeRoot to the pinned, folder-contained PKForge checkout." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="../../src/PKHeXMobile.Domain/PKHeXMobile.Domain.csproj" />
    <ProjectReference Include="$(PKForgeRoot)/src/PKForge.Domain/PKForge.Domain.csproj" />
    <Compile Include="$(PKForgeRoot)/src/PKForge.App/Services/ReadOnlyFolderFileAccess.cs" Link="ReadOnlyFolderFileAccess.cs" />
    <Compile Include="$(PKForgeRoot)/src/PKForge.App/Services/ReadOnlySaveWriter.cs" Link="ReadOnlySaveWriter.cs" />
  </ItemGroup>
</Project>
