<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <Target Name="RequirePinnedPKForge" BeforeTargets="ResolveReferences" Condition="'$(PKForgeRoot)' == ''">
    <Error Text="Set PKForgeRoot to the pinned, official-Core-adapted temporary PKForge checkout." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="../PKHeXMobile.Domain/PKHeXMobile.Domain.csproj" />
    <ProjectReference Include="$(PKForgeRoot)/src/PKForge.Engine/PKForge.Engine.csproj" />
  </ItemGroup>
</Project>
